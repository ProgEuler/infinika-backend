# Copy to project_root/.env (docker-compose reads that path) and fill in real values.
# Never commit the real file.

SECRET_KEY=change-me-generate-with-python-c-secrets-token-urlsafe-50
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Set to False once nginx (or another web server) serves /media/ itself
SERVE_MEDIA=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-app-password

DB_ENGINE=django.db.backends.postgresql
DB_NAME=study_pulse
DB_USER=study_pulse
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
