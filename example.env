# Copy to project_root/.env (docker-compose reads that path) and fill in real values.
# Never commit the real file.

SECRET_KEY=change-me-generate-with-python-c-secrets-token-urlsafe-50
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Set to False once nginx (or another web server) serves /media/ itself
SERVE_MEDIA=True

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Study Pulse <no-reply@yourdomain.com>

# Without RESEND_API_KEY, emails are printed to the logs instead of sent.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DB_SCHEMA=study_pulse

DB_ENGINE=django.db.backends.postgresql
DB_NAME=study_pulse
DB_USER=study_pulse
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
